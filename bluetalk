    <script>
    // ============================================
    // FIREBASE CONFIGURATION (SUDAH DI-EDIT!)
    // ============================================
    const firebaseConfig = {
        apiKey: "AIzaSyDMSYFTgrBOVfl2QoRKjMFyBkYLRUGby-M",
        authDomain: "bluetalk-777.firebaseapp.com",
        databaseURL: "https://bluetalk-777-default-rtdb.firebaseio.com",
        projectId: "bluetalk-777",
        storageBucket: "bluetalk-777.firebasestorage.app",
        messagingSenderId: "877171811330",
        appId: "1:877171811330:web:e8b9de01ba5797efbaf31b"
    };

    // Initialize Firebase
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    console.log('Firebase initialized successfully!');

    // ============================================
    // GLOBAL VARIABLES
    // ============================================
    let currentUser = null;
    let currentChatUser = null;
    let currentChatId = null;
    let messagesListener = null;
    let peerConnection = null;
    let localStream = null;
    let remoteStream = null;
    let isCallActive = false;
    let callTimer = null;
    let callDuration = 0;
    let isMuted = false;
    let isCameraOff = false;
    let isVideoCall = false;

    // ============================================
    // INITIALIZATION
    // ============================================
    window.onload = function() {
        checkAuth();
        initializeEmojiPicker();
        setupAuthTabs();
    };

    function checkAuth() {
        const savedUser = localStorage.getItem('currentUser');
        if (savedUser) {
            currentUser = JSON.parse(savedUser);
            showMainApp();
        } else {
            document.getElementById('authScreen').style.display = 'block';
        }
    }

    function setupAuthTabs() {
        const tabs = document.querySelectorAll('.auth-tab');
        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                tabs.forEach(t => t.classList.remove('active'));
                this.classList.add('active');

                const tabName = this.dataset.tab;
                document.querySelectorAll('.auth-form').forEach(form => {
                    form.classList.remove('active');
                });
                document.getElementById(tabName + 'Form').classList.add('active');
            });
        });
    }

    // ============================================
    // AUTHENTICATION
    // ============================================
    async function register() {
        const username = document.getElementById('registerUsername').value.trim();
        const phone = document.getElementById('registerPhone').value.trim();

        if (!username || !phone) {
            alert('Mohon isi semua field!');
            return;
        }

        if (username.length < 3) {
            alert('Username minimal 3 karakter!');
            return;
        }

        try {
            const snapshot = await database.ref('users').orderByChild('username').equalTo(username).once('value');
            
            if (snapshot.exists()) {
                alert('Username sudah digunakan!');
                return;
            }

            const userId = Date.now().toString();
            const userData = {
                userId: userId,
                username: username,
                phone: phone,
                profilePic: getDefaultAvatar(),
                createdAt: Date.now(),
                online: true,
                lastSeen: Date.now()
            };

            await database.ref('users/' + userId).set(userData);
            
            currentUser = userData;
            localStorage.setItem('currentUser', JSON.stringify(userData));
            
            document.getElementById('authScreen').style.display = 'none';
            showMainApp();
            
        } catch (error) {
            console.error('Register error:', error);
            alert('Gagal mendaftar: ' + error.message);
        }
    }

    async function login() {
        const username = document.getElementById('loginUsername').value.trim();

        if (!username) {
            alert('Mohon masukkan username!');
            return;
        }

        try {
            const snapshot = await database.ref('users').orderByChild('username').equalTo(username).once('value');
            
            if (!snapshot.exists()) {
                alert('Username tidak ditemukan!');
                return;
            }

            snapshot.forEach((childSnapshot) => {
                currentUser = childSnapshot.val();
            });

            await database.ref('users/' + currentUser.userId).update({
                online: true,
                lastSeen: Date.now()
            });

            localStorage.setItem('currentUser', JSON.stringify(currentUser));
            
            document.getElementById('authScreen').style.display = 'none';
            showMainApp();
            
        } catch (error) {
            console.error('Login error:', error);
            alert('Gagal login: ' + error.message);
        }
    }

    function logout() {
        if (confirm('Yakin ingin keluar?')) {
            if (currentUser) {
                database.ref('users/' + currentUser.userId).update({
                    online: false,
                    lastSeen: Date.now()
                });
            }
            
            localStorage.removeItem('currentUser');
            currentUser = null;
            location.reload();
        }
    }

    // ============================================
    // MAIN APP UI
    // ============================================
    function showMainApp() {
        document.getElementById('mainApp').style.display = 'block';
        loadUsers();
        loadStories();
        setupPresence();
    }

    function switchTab(tabName) {
        document.querySelectorAll('.nav-tab').forEach(tab => {
            tab.classList.remove('active');
        });
        document.querySelector(`.nav-tab[data-tab="${tabName}"]`).classList.add('active');

        document.querySelectorAll('.tab-content').forEach(content => {
            content.classList.remove('active');
        });
        document.getElementById(tabName + 'Tab').classList.add('active');

        if (tabName === 'stories') {
            loadStories();
        } else if (tabName === 'chats') {
            loadUsers();
        }
    }

    function toggleDarkMode() {
        document.body.classList.toggle('dark-mode');
        localStorage.setItem('darkMode', document.body.classList.contains('dark-mode'));
    }

    function showSettings() {
        alert('Settings coming soon!');
    }

    // ============================================
    // USERS & SEARCH
    // ============================================
    async function loadUsers() {
        const chatList = document.getElementById('chatList');
        chatList.innerHTML = '';

        try {
            const snapshot = await database.ref('users').once('value');
            const users = [];

            snapshot.forEach((childSnapshot) => {
                const user = childSnapshot.val();
                if (user.userId !== currentUser.userId) {
                    users.push(user);
                }
            });

            users.forEach(user => {
                const li = createChatItem(user);
                chatList.appendChild(li);
            });

        } catch (error) {
            console.error('Load users error:', error);
        }
    }

    function createChatItem(user) {
        const li = document.createElement('li');
        li.className = 'chat-item';
        li.onclick = () => openChat(user);

        li.innerHTML = `
            <div class="chat-avatar">
                <img src="${user.profilePic || getDefaultAvatar()}" alt="${user.username}">
                ${user.online ? '<div class="online-indicator"></div>' : ''}
            </div>
            <div class="chat-info">
                <div class="chat-header">
                    <div class="chat-name">${user.username}</div>
                    <div class="chat-time">${user.online ? 'Online' : formatLastSeen(user.lastSeen)}</div>
                </div>
                <div class="chat-preview">${user.phone || 'Tap untuk chat'}</div>
            </div>
        `;

        return li;
    }

    async function searchUsers() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
        const chatList = document.getElementById('chatList');
        chatList.innerHTML = '';

        if (!searchTerm) {
            loadUsers();
            return;
        }

        try {
            const snapshot = await database.ref('users').once('value');
            const users = [];

            snapshot.forEach((childSnapshot) => {
                const user = childSnapshot.val();
                if (user.userId !== currentUser.userId && 
                    user.username.toLowerCase().includes(searchTerm)) {
                    users.push(user);
                }
            });

            if (users.length === 0) {
                chatList.innerHTML = '<p style="text-align:center; padding: 20px; color: var(--text-light);">User tidak ditemukan</p>';
                return;
            }

            users.forEach(user => {
                const li = createChatItem(user);
                chatList.appendChild(li);
            });

        } catch (error) {
            console.error('Search error:', error);
        }
    }

