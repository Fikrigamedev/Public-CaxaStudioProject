<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BlueTalk - Chat App</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-color: #4A90E2;
            --primary-dark: #357ABD;
            --primary-light: #E3F2FD;
            --bg-color: #FFFFFF;
            --chat-bg: #F5F5F5;
            --text-color: #333333;
            --text-light: #757575;
            --border-color: #E0E0E0;
            --success-color: #4CAF50;
            --danger-color: #F44336;
            --online-color: #4CAF50;
        }

        body.dark-mode {
            --bg-color: #1A1A1A;
            --chat-bg: #2D2D2D;
            --text-color: #FFFFFF;
            --text-light: #B0B0B0;
            --border-color: #404040;
            --primary-light: #1E3A5F;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            overflow-x: hidden;
        }

        .icon {
            width: 24px;
            height: 24px;
            fill: currentColor;
        }

        .icon-small {
            width: 20px;
            height: 20px;
        }

        #authScreen {
            display: none;
            min-height: 100vh;
            padding: 20px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
        }

        .auth-container {
            max-width: 400px;
            margin: 50px auto;
            background: var(--bg-color);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .auth-logo {
            text-align: center;
            margin-bottom: 30px;
        }

        .auth-logo h1 {
            color: var(--primary-color);
            font-size: 36px;
            margin-bottom: 10px;
        }

        .auth-logo p {
            color: var(--text-light);
            font-size: 14px;
        }

        .auth-tabs {
            display: flex;
            margin-bottom: 30px;
            border-bottom: 2px solid var(--border-color);
        }

        .auth-tab {
            flex: 1;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            color: var(--text-light);
            font-weight: 600;
            transition: all 0.3s;
            border-bottom: 3px solid transparent;
        }

        .auth-tab.active {
            color: var(--primary-color);
            border-bottom-color: var(--primary-color);
        }

        .auth-form {
            display: none;
        }

        .auth-form.active {
            display: block;
        }

        .input-group {
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-color);
            font-weight: 500;
            font-size: 14px;
        }

        .input-group input {
            width: 100%;
            padding: 15px;
            border: 2px solid var(--border-color);
            border-radius: 10px;
            font-size: 16px;
            background: var(--bg-color);
            color: var(--text-color);
            transition: all 0.3s;
        }

        .input-group input:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .btn-primary {
            width: 100%;
            padding: 15px;
            background: var(--primary-color);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

        #mainApp {
            display: none;
            max-width: 1200px;
            margin: 0 auto;
            height: 100vh;
        }

        .app-header {
            background: var(--primary-color);
            color: white;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .app-header h1 {
            font-size: 24px;
            font-weight: 600;
        }

        .header-actions {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .header-btn {
            background: none;
            border: none;
            color: white;
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .header-btn:hover {
            background: rgba(255,255,255,0.2);
        }

        .nav-tabs {
            display: flex;
            background: var(--bg-color);
            border-bottom: 2px solid var(--border-color);
        }

        .nav-tab {
            flex: 1;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            color: var(--text-light);
            font-weight: 600;
            transition: all 0.3s;
            border-bottom: 3px solid transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .nav-tab.active {
            color: var(--primary-color);
            border-bottom-color: var(--primary-color);
        }

        .tab-content {
            display: none;
            height: calc(100vh - 130px);
            overflow-y: auto;
        }

        .tab-content.active {
            display: block;
        }

        .stories-container {
            padding: 20px;
        }

        .my-story-section {
            margin-bottom: 30px;
        }

        .my-story-card {
            background: var(--bg-color);
            border: 2px dashed var(--primary-color);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

        .my-story-card:hover {
            background: var(--primary-light);
        }

        .my-story-card svg {
            color: var(--primary-color);
            margin-bottom: 10px;
        }

        .stories-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 15px;
        }

        .story-item {
            cursor: pointer;
            text-align: center;
        }

        .story-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 3px solid var(--primary-color);
            padding: 3px;
            margin: 0 auto 10px;
            position: relative;
        }

        .story-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .story-item p {
            font-size: 12px;
            color: var(--text-color);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .chats-container {
            padding: 15px;
        }

        .search-bar {
            position: relative;
            margin-bottom: 20px;
        }

        .search-bar input {
            width: 100%;
            padding: 15px 15px 15px 50px;
            border: 2px solid var(--border-color);
            border-radius: 25px;
            font-size: 16px;
            background: var(--bg-color);
            color: var(--text-color);
        }

        .search-bar input:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-light);
        }

        .chat-list {
            list-style: none;
        }

        .chat-item {
            display: flex;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid var(--border-color);
            cursor: pointer;
            transition: all 0.3s;
        }

        .chat-item:hover {
            background: var(--primary-light);
        }

        .chat-avatar {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            margin-right: 15px;
            position: relative;
            flex-shrink: 0;
        }

        .chat-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .online-indicator {
            width: 12px;
            height: 12px;
            background: var(--online-color);
            border-radius: 50%;
            position: absolute;
            bottom: 2px;
            right: 2px;
            border: 2px solid var(--bg-color);
        }

        .chat-info {
            flex: 1;
            overflow: hidden;
        }

        .chat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
        }

        .chat-name {
            font-weight: 600;
            color: var(--text-color);
        }

        .chat-time {
            font-size: 12px;
            color: var(--text-light);
        }

        .chat-preview {
            font-size: 14px;
            color: var(--text-light);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        #chatRoom {
            display: none;
            height: 100vh;
            flex-direction: column;
        }

        .chat-room-header {
            background: var(--primary-color);
            color: white;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        .back-btn {
            background: none;
            border: none;
            color: white;
            cursor: pointer;
            padding: 5px;
            display: flex;
            align-items: center;
        }

        .chat-room-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
        }

        .chat-room-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .chat-room-info {
            flex: 1;
        }

        .chat-room-name {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .chat-room-status {
            font-size: 12px;
            opacity: 0.9;
        }

        .chat-room-actions {
            display: flex;
            gap: 10px;
        }

        .action-btn {
            background: none;
            border: none;
            color: white;
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            transition: all 0.3s;
            display: flex;
            align-items: center;
        }

        .action-btn:hover {
            background: rgba(255,255,255,0.2);
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            background: var(--chat-bg);
        }

        .message {
            display: flex;
            margin-bottom: 15px;
            align-items: flex-end;
            gap: 5px;
        }

        .message.sent {
            flex-direction: row-reverse;
        }

        .message-bubble {
            max-width: 70%;
            padding: 12px 16px;
            border-radius: 18px;
            position: relative;
        }

        .message.received .message-bubble {
            background: var(--bg-color);
            color: var(--text-color);
            border-bottom-left-radius: 4px;
        }

        .message.sent .message-bubble {
            background: var(--primary-color);
            color: white;
            border-bottom-right-radius: 4px;
        }

        .message-text {
            margin-bottom: 5px;
            word-wrap: break-word;
        }

        .message-image {
            max-width: 100%;
            max-height: 300px;
            border-radius: 10px;
            margin-bottom: 5px;
        }

        .message-time {
            font-size: 11px;
            opacity: 0.7;
            text-align: right;
        }

        .message-action-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 5px;
            color: var(--text-light);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .message:hover .message-action-btn {
            opacity: 1;
        }

        .chat-input-container {
            padding: 15px;
            background: var(--bg-color);
            border-top: 1px solid var(--border-color);
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .chat-input-actions {
            display: flex;
            gap: 10px;
        }

        .input-action-btn {
            background: none;
            border: none;
            color: var(--primary-color);
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            transition: all 0.3s;
            display: flex;
            align-items: center;
        }

        .input-action-btn:hover {
            background: var(--primary-light);
        }

        .chat-input {
            flex: 1;
            padding: 12px 20px;
            border: 2px solid var(--border-color);
            border-radius: 25px;
            font-size: 16px;
            background: var(--bg-color);
            color: var(--text-color);
            resize: none;
            max-height: 100px;
            font-family: inherit;
        }

        .chat-input:focus {
            outline: none;
            border-color: var(--primary-color);
        }

        .send-btn {
            background: var(--primary-color);
            border: none;
            color: white;
            cursor: pointer;
            padding: 12px;
            border-radius: 50%;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .send-btn:hover {
            background: var(--primary-dark);
            transform: scale(1.1);
        }

        .send-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        #callScreen {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-color) 100%);
            z-index: 1000;
            color: white;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 50px 20px;
        }

        .call-user-info {
            text-align: center;
        }

        .call-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            margin: 0 auto 20px;
            border: 4px solid white;
        }

        .call-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .call-username {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .call-status {
            font-size: 16px;
            opacity: 0.9;
        }

        .call-timer {
            font-size: 24px;
            font-weight: 600;
            margin-top: 20px;
        }

        .video-container {
            position: relative;
            width: 100%;
            max-width: 600px;
            height: 400px;
            background: #000;
            border-radius: 20px;
            overflow: hidden;
            display: none;
        }

        .video-container.active {
            display: block;
        }

        #remoteVideo {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        #localVideo {
            position: absolute;
            bottom: 20px;
            right: 20px;
            width: 150px;
            height: 200px;
            border-radius: 15px;
            border: 3px solid white;
            object-fit: cover;
        }

        .call-controls {
            display: flex;
            gap: 20px;
        }

        .call-control-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .call-control-btn.mute {
            background: rgba(255,255,255,0.3);
            color: white;
        }

        .call-control-btn.end {
            background: var(--danger-color);
            color: white;
        }

        .call-control-btn:hover {
            transform: scale(1.1);
        }

        #storyViewer {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            z-index: 1000;
        }

        .story-viewer-header {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            padding: 20px;
            background: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent);
            z-index: 10;
        }

        .story-user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .story-user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }

        .story-user-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .story-user-name {
            color: white;
            font-weight: 600;
        }

        .story-close-btn {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255,255,255,0.3);
            border: none;
            color: white;
            cursor: pointer;
            padding: 10px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            z-index: 11;
        }

        .story-content {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .story-content img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 2000;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: var(--bg-color);
            border-radius: 20px;
            padding: 30px;
            max-width: 400px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--text-color);
        }

        .modal-close {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-light);
            font-size: 24px;
        }

        .file-upload {
            border: 2px dashed var(--primary-color);
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 20px;
        }

        .file-upload:hover {
            background: var(--primary-light);
        }

        .file-upload input[type="file"] {
            display: none;
        }

        .preview-image {
            max-width: 100%;
            border-radius: 10px;
            margin: 20px 0;
        }

        .emoji-picker {
            display: none;
            position: absolute;
            bottom: 70px;
            left: 20px;
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 15px;
            padding: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            max-width: 300px;
            max-height: 300px;
            overflow-y: auto;
            z-index: 100;
        }

        .emoji-picker.active {
            display: block;
        }

        .emoji-grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 5px;
        }

        .emoji-item {
            font-size: 24px;
            cursor: pointer;
            padding: 5px;
            border-radius: 5px;
            transition: all 0.3s;
            text-align: center;
        }

        .emoji-item:hover {
            background: var(--primary-light);
            transform: scale(1.2);
        }

        .hidden {
            display: none !important;
        }

        .mt-20 {
            margin-top: 20px;
        }

        @media (max-width: 768px) {
            .auth-container {
                padding: 30px 20px;
            }

            .stories-list {
                grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
            }

            .message-bubble {
                max-width: 85%;
            }

            #localVideo {
                width: 100px;
                height: 133px;
            }
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--chat-bg);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--primary-dark);
        }
    </style>
</head>
