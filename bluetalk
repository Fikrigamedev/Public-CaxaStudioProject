    function openChat(user) {
        currentChatUser = user;
        
        const ids = [currentUser.userId, user.userId].sort();
        currentChatId = ids[0] + '_' + ids[1];

        document.getElementById('mainApp').style.display = 'none';
        document.getElementById('chatRoom').style.display = 'flex';

        document.getElementById('chatRoomName').textContent = user.username;
        document.getElementById('chatRoomAvatar').src = user.profilePic || getDefaultAvatar();
        document.getElementById('chatRoomStatus').textContent = user.online ? 'Online' : formatLastSeen(user.lastSeen);

        loadMessages();
